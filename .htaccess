# ═══════════════════════════════════════════
#  Life Charge Chiropractic — Apache config
#  Performance + SEO + 301 redirects + security
#  Replaces previous WordPress / LiteSpeed .htaccess
# ═══════════════════════════════════════════

Options -MultiViews -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

RewriteEngine On
RewriteBase /

# ─────────────────────────────────────────────
# STEP 1 — explicit 301 redirects from old WordPress URLs
# Run before any rewrites so they take precedence.
# ─────────────────────────────────────────────

# Typos
RewriteRule ^headaches-and-migranes/?$ https://lifechargechiropractic.com/headaches-and-migraines/ [R=301,L]
RewriteRule ^our-philosphy/?$ https://lifechargechiropractic.com/our-philosophy/ [R=301,L]

# Retired introduction has a direct equivalent on the current site.
RewriteRule ^2024/07/12/intro-to-our-philosophy/?$ https://lifechargechiropractic.com/our-philosophy/ [R=301,L]
Redirect 301 /blog/2024/07/12/intro-to-our-philosophy/ https://lifechargechiropractic.com/our-philosophy/

# Old slug variants
RewriteRule ^reviews-2/?$ https://lifechargechiropractic.com/reviews/ [R=301,L]
RewriteRule ^caraccident/?$ https://lifechargechiropractic.com/auto-accident/ [R=301,L]
RewriteRule ^elementor-821/?$ https://lifechargechiropractic.com/ [R=301,L]

# Pages without a direct equivalent — redirect to closest topical match
RewriteRule ^kneepain/?$ https://lifechargechiropractic.com/sports-injury/ [R=301,L]
RewriteRule ^shoulder-pain/?$ https://lifechargechiropractic.com/sports-injury/ [R=301,L]
RewriteRule ^headaches/?$ https://lifechargechiropractic.com/headaches-and-migraines/ [R=301,L]
RewriteRule ^headachequiz/?$ https://lifechargechiropractic.com/headaches-and-migraines/ [R=301,L]
RewriteRule ^lowbackpainquiz/?$ https://lifechargechiropractic.com/low-back-pain/ [R=301,L]
RewriteRule ^painquiz/?$ https://lifechargechiropractic.com/contact-us/ [R=301,L]
RewriteRule ^claimoffer/?$ https://lifechargechiropractic.com/contact-us/ [R=301,L]
RewriteRule ^chat/?$ https://lifechargechiropractic.com/contact-us/ [R=301,L]
RewriteRule ^refer/?$ https://lifechargechiropractic.com/contact-us/ [R=301,L]
RewriteRule ^referral-list/?$ https://lifechargechiropractic.com/contact-us/ [R=301,L]
RewriteRule ^digest/?$ https://lifechargechiropractic.com/blog/ [R=301,L]
RewriteRule ^spine-atlas/?$ https://lifechargechiropractic.com/ [R=301,L]
RewriteRule ^movement-tracker/?$ https://lifechargechiropractic.com/ [R=301,L]
RewriteRule ^spineai-evaluation/?$ https://lifechargechiropractic.com/ [R=301,L]
RewriteRule ^llms-txt/?$ https://lifechargechiropractic.com/ [R=301,L]
RewriteRule ^conditions-we-help-gallatin-chiropractor/?$ https://lifechargechiropractic.com/low-back-pain/ [R=301,L]
RewriteRule ^thermal-imaging-services-at-life-charge-chiropractic/?$ https://lifechargechiropractic.com/thermal-imaging/ [R=301,L]
RewriteRule ^eat-strong-stay-strong-the-diet-that-supports-longevity-after-55/?$ https://lifechargechiropractic.com/blog/ [R=301,L]

# Specific 404 blog URLs flagged by SEMrush — redirect to closest topical page.
# Uses Redirect (mod_alias) instead of RewriteRule because /blog/ is a WordPress
# install with its own .htaccess that would reset RewriteRules from this parent.
Redirect 301 /blog/2025/05/03/why-chiropractic-care-is-essential-after-a-car-accident-in-gallatin-and-hendersonville/ https://lifechargechiropractic.com/auto-accident/
Redirect 301 /blog/2025/05/31/a-chiropractors-guide-to-your-babys-growing-spine-0-2-years/ https://lifechargechiropractic.com/pediatric/
Redirect 301 /blog/2026/04/22/thermography-vs-x-ray-what-each-one-actually-shows-you/ https://lifechargechiropractic.com/thermal-imaging/

# Removed work-injury page — redirect any indexed copies to auto-accident
RewriteRule ^work-injury/?$ https://lifechargechiropractic.com/auto-accident/ [R=301,L]

# All old WordPress dated blog posts → same post under /blog/
RewriteRule ^([0-9]{4}/[0-9]{2}/[0-9]{2}/.+/?$) https://lifechargechiropractic.com/blog/$1 [R=301,L]

# Old PKX permalink variant
RewriteRule ^find-a-pi-kappa-chi-brother/?$ https://lifechargechiropractic.com/find-a-pi-kappa-chi-brother-2/ [R=301,L]

# Preserve old absolute media URLs from WordPress posts.
RewriteRule ^wp-content/uploads/(.*)$ https://lifechargechiropractic.com/blog/wp-content/uploads/$1 [R=301,L]

# Block legacy WordPress endpoints at the site root.
RewriteRule ^wp-admin(/.*)?$ https://lifechargechiropractic.com/ [R=301,L]
RewriteRule ^wp-login\.php$ https://lifechargechiropractic.com/ [R=301,L]
RewriteRule ^wp-content(/.*)?$ https://lifechargechiropractic.com/ [R=301,L]
RewriteRule ^xmlrpc\.php$      -  [F,L]

# ─────────────────────────────────────────────
# STEP 2 - canonical public URLs, before host redirects and internal rewrites.
# Direct requests for /index.html or /about/index.html go to the real directory.
# THE_REQUEST prevents DirectoryIndex's internal lookup from looping.
RewriteCond %{THE_REQUEST} \s/+(.*/)?index(?:\.html)?/?[\s?] [NC]
RewriteRule ^(?:.*/)?index(?:\.html)?/?$ https://lifechargechiropractic.com/%1 [R=301,L]

# Legacy .html requests go directly to the HTTPS canonical directory.
RewriteCond %{THE_REQUEST} \s/+([^\s]+?)\.html[\s?] [NC]
RewriteRule ^ https://lifechargechiropractic.com/%1/ [R=301,L]

# Canonical trailing slash for actual directory routes, including HTTP/www requests.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.+)$ https://lifechargechiropractic.com/$1/ [R=301,L]

# HTTPS and non-www in one redirect, keeping the path and query string.
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.lifechargechiropractic\.com$ [NC]
RewriteRule ^ https://lifechargechiropractic.com%{REQUEST_URI} [R=301,L]

# ─────────────────────────────────────────────
# STEP 3 — internally serve /about/ (or /about) from /about.html
# Skip if it's already a real file or directory.
# ─────────────────────────────────────────────
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^/.]+)/?$ /$1.html [L]

# ─── Block sensitive files ───
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
<FilesMatch "\.(md|log|bak|inc|sql|env)$">
  Require all denied
</FilesMatch>
<FilesMatch "(wp-config\.php|wp-cron\.php|wp-blog-header\.php|xmlrpc\.php|wp-mail\.php|wp-trackback\.php|wp-comments-post\.php|wp-load\.php|wp-settings\.php|wp-activate\.php|wp-signup\.php|wp-links-opml\.php)$">
  Require all denied
</FilesMatch>

# ─── Compression ───
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml application/atom+xml
  AddOutputFilterByType DEFLATE image/svg+xml font/ttf font/otf
</IfModule>

# ─── Browser caching ───
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 month"
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType text/javascript           "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"
  ExpiresByType font/ttf                  "access plus 1 year"
  ExpiresByType font/woff                 "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType application/font-woff2    "access plus 1 year"
  ExpiresByType application/xml           "access plus 1 day"
  ExpiresByType text/xml                  "access plus 1 day"
</IfModule>

# ─── Cache-Control + security headers ───
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|webp|jpg|jpeg|png|gif|svg|ico|ttf|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(xml|txt)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # Header set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# ─── MIME types ───
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddType font/ttf .ttf
  AddType application/manifest+json .webmanifest
</IfModule>
